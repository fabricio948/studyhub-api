    "start": "node --env-file=.env dist/index.js",
    "dev": "npm run fix && npm run check && npm run build && npm start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
