    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
